.DS_Store

# Local secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend
node_modules/
dist/
build/
app/web_dist/
*.tsbuildinfo
web/vite.config.js
web/vite.config.d.ts

# Runtime outputs
outputs/
logs/
log.md
*.log

# docs/ holds README screenshots; allow docs/images/, ignore everything else
# Use specific subpath patterns (not `docs/*` which doesn't recurse into
# subdirectories and accidentally blocks all nested files).
/docs/notes/
/docs/drafts/
/docs/*.md
!/docs/images/
/docs/*.tmp

# Local sample/generated data
*.parquet
*.csv
samples/

# IDE
.idea/
.vscode/

# Claude Code local session cache
.claude/

# Local data samples / reference materials (never committed)
data/
